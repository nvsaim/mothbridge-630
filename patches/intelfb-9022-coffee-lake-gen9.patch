     uint8_t fVer = 0;
 
     uint32_t rd(uint32_t off) const { return *(volatile uint32_t *)(fRegs + off); }
+    // true when the eDP transcoder (display versions below 12) is enabled and fed by pipe p
+    bool edpFeedsPipe(int p) const {
+        if (fVer >= 12) return false;
+        uint32_t c = rd(kEdpDdiCtl);
+        if (!(c & (1u << 31))) return false;
+        uint32_t in = (c >> 12) & 7;
+        return in == 0 ? p == 0 : (in >= 4 && in <= 6 && (int)(in - 4) == p);
+    }
+    // XRGB8888: display 11+ format field is bits 27:23 (== 8); before that bits 27:24 (== 4), and bit 23 is PIPE_CSC_ENABLE
+    bool isXrgb8888(uint32_t ctl) const { return fVer >= 11 ? fmtOf(ctl) == 8 : ((ctl >> 24) & 0xF) == 4; }
     bool adoptFirmwareMode();
 
