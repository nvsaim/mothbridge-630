+// display versions below 12 (Haswell..Ice Lake, so Coffee Lake = 9) drive an eDP panel from TRANSCODER_EDP rather than
+// transcoder A (Linux TRANSCODER_EDP_OFFSET): its timings are at 0x6f000, its pipe config (enable bit 31) at 0x7f008, and
+// TRANS_DDI_FUNC_CTL_EDP (0x6f400: enable bit 31, input-pipe select bits 14:12, 0 = pipe A, 4/5/6 = A/B/C) says which pipe
+// feeds it. Measured on a UHD 630 (8086:3e9b): PIPECONF A 0, 0x7f008 0xc0000000, 0x6f400 0x82000002, timings at 0x6f000
+constexpr uint32_t kTransEdp = 0x6F000u, kEdpConf = 0x7F008u, kEdpDdiCtl = 0x6F400u;
 constexpr uint32_t fmtOf(uint32_t ctl)  { return (ctl >> 23) & 0x1F; }
 constexpr uint32_t tileOf(uint32_t ctl) { return (ctl >> 10) & 0x7; }
 }
